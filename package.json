{
  "name": "sysmonitor",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.4.2",
  "publisher": "LiChenxi",
  "license": "MIT",
  "icon": "icon.png",
  "homepage": "https://github.com/lcx-0504/sysmonitor",
  "bugs": {
    "url": "https://github.com/lcx-0504/sysmonitor/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lcx-0504/sysmonitor.git"
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node scripts/check-syntax.js && npm test"
  },
  "categories": [
    "Visualization",
    "Machine Learning",
    "Data Science"
  ],
  "keywords": [
    "system",
    "monitor",
    "cpu",
    "gpu",
    "remote"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:sysmonitor.editor"
  ],
  "main": "./extension.js",
  "extensionKind": ["workspace", "ui"],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sysmonitor-container",
          "title": "%viewTitle%",
          "icon": "./icon.svg"
        }
      ]
    },
    "views": {
      "sysmonitor-container": [
        {
          "type": "webview",
          "id": "sysmonitor.panel",
          "name": "%viewName%"
        }
      ]
    },
    "commands": [
      {
        "command": "sysmonitor.openPanel",
        "title": "%cmdOpen%"
      },
      {
        "command": "sysmonitor.openEditor",
        "title": "%cmdOpenEditor%",
        "icon": "$(open-in-product)"
      },
      {
        "command": "sysmonitor.openWindow",
        "title": "%cmdOpenWindow%",
        "icon": "$(multiple-windows)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sysmonitor.openEditor",
          "when": "view == sysmonitor.panel",
          "group": "navigation@1"
        },
        {
          "command": "sysmonitor.openWindow",
          "when": "view == sysmonitor.panel",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "System Monitor",
      "properties": {
        "sysmonitor.refreshInterval": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 30,
          "description": "Refresh interval in seconds"
        },
        "sysmonitor.statusBar": {
          "type": "object",
          "default": {
            "barEnabled": true,
            "alignment": "left",
            "priority": 10,
            "cpu": true,
            "ram": true,
            "disk": false,
            "diskIO": "off",
            "net": "off",
            "ssh": false,
            "gpu": {
              "summary": true,
              "showIdleIds": false,
              "mode": "off",
              "cards": [],
              "firstN": 2,
              "metric": "both",
              "skipIdle": false
            }
          },
          "description": "Status bar display configuration"
        },
        "sysmonitor.disk": {
          "type": "object",
          "default": {
            "mountFilter": "default",
            "hideParentMounts": true
          },
          "description": "Disk monitoring settings"
        },
        "sysmonitor.display": {
          "type": "object",
          "default": {
            "charts": true,
            "sparkMinutes": 5,
            "tabularNums": true,
            "hiddenGroups": {
              "system": false,
              "disk": false,
              "network": false,
              "gpuSummary": false,
              "gpuCards": false
            },
            "highlightMyGpus": true,
            "showGpuPicker": true,
            "showGpuUsers": true
          },
          "description": "Display settings"
        },
        "sysmonitor.servers": {
          "type": "object",
          "default": {
            "visibleOnly": false,
            "restoreTabs": true
          },
          "description": "SSH server monitoring and session restoration settings"
        }
      }
    }
  }
}
